# Copy to a protected .env.production file; never commit the copy.  Generate
# each secret independently, for example: openssl rand -base64 36
POSTGRES_PASSWORD=replace-with-a-unique-24-plus-character-secret
APP_DB_PASSWORD=replace-with-a-different-unique-24-plus-character-secret
JWT_SECRET=replace-with-a-different-unique-32-plus-character-secret
JWT_KEY_ID=production-current
JWT_PREVIOUS_SECRETS=
MFA_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32
POSTGRES_DB=linkerp

# This must be the one browser address your mill uses, terminated by a real
# TLS reverse proxy in front of the web container.
CORS_ORIGIN=https://erp.yourmill.in
FORCE_HTTPS=true
WEB_PORT=8080
PG_POOL_MAX=10
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_MODE=database
LOG_REQUESTS=true

# Release and operations gates. BACKUP_DIR must be a protected mount that is
# copied off this server. The webhook must accept {"text":"..."} JSON.
RELEASE_TAG=v0.0.0-replace
BACKUP_DIR=/mnt/link-erp-backups
BACKUP_OFFSITE_CONFIRMED=false
HEALTHCHECK_URL=https://erp.yourmill.in/health
ALERT_WEBHOOK_URL=https://alerts.example.in/link-erp

# Meta WhatsApp Business Cloud API. Keep blank until the approved template and
# provider test are complete; a blank configuration disables delivery safely.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_INVOICE_TEMPLATE=invoice_ready
WHATSAPP_PAYMENT_REMINDER_TEMPLATE=payment_reminder
WHATSAPP_TEMPLATE_LANGUAGE=en

# Local godown bridge (installed on each scanning PC, never on the server).
VITE_PRINT_BRIDGE_URL=http://127.0.0.1:17420/print
VITE_SCALE_BRIDGE_URL=http://127.0.0.1:17420/scale
VITE_SCALE_BAUD_RATE=9600
HARDWARE_BRIDGE_TOKEN=replace-with-a-unique-pairing-token-of-24-plus-characters

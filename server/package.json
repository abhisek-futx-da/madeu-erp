{
  "name": "link-erp-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --experimental-strip-types --watch src/index.ts",
    "start": "node --env-file-if-exists=.env.local --experimental-strip-types src/index.ts",
    "dev:test-db": "DATABASE_URL=\"${TEST_DATABASE_URL:-postgresql://link_erp_app@/linkerp_test?host=/tmp&port=5432}\" JWT_SECRET=\"${JWT_SECRET:-preview-only-secret-not-used-anywhere-real}\" PORT=\"${PORT:-4010}\" node --experimental-strip-types --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "./test/run.sh",
    "test:against-running": "node --env-file-if-exists=.env.local --experimental-strip-types --test-concurrency=1 --test test/*.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.3"
  }
}

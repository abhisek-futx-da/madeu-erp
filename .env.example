# Copy to .env and change every value. The .env file is not committed.
#
# Generate the two secrets with:
#   openssl rand -base64 36

# Postgres superuser password (used for migrations and backups).
POSTGRES_PASSWORD=change-me-before-anyone-can-reach-this
POSTGRES_DB=linkerp

# The role the API connects as. Not the owner: RLS is only a boundary for a
# non-owner role, and the API must never be able to alter its own schema.
APP_DB_PASSWORD=change-me-too

# Signs session tokens. Changing it signs everyone out, which is the correct
# response to a suspected leak.
JWT_SECRET=change-me-as-well-at-least-32-characters-long
# During rotation, put the old key in JWT_PREVIOUS_SECRETS for no more than the
# 12-hour session lifetime, then remove it. Separate multiple old keys by comma.
JWT_KEY_ID=local-current
JWT_PREVIOUS_SECRETS=
MFA_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# Exactly the origin the browser loads the app from. An empty value allows
# localhost only; it must never be left empty in production.
CORS_ORIGIN=http://localhost:8080

# Set true behind TLS so the browser is told never to fall back to http.
FORCE_HTTPS=false

WEB_PORT=8080
PG_POOL_MAX=10
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_MODE=database
LOG_REQUESTS=true
BACKUP_DIR=./backups

# Optional external integrations. Leave blank for local evaluation; the ERP
# will show them as unconfigured rather than pretending a message was sent.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_INVOICE_TEMPLATE=invoice_ready
WHATSAPP_PAYMENT_REMINDER_TEMPLATE=payment_reminder
WHATSAPP_TEMPLATE_LANGUAGE=en

# Optional bridge running on each godown PC. Both URLs must point to loopback;
# the matching pairing token is configured in hardware-bridge/.env.local.
VITE_PRINT_BRIDGE_URL=
VITE_SCALE_BRIDGE_URL=
VITE_SCALE_BAUD_RATE=9600
HARDWARE_BRIDGE_TOKEN=

BRIDGE_TOKEN=replace-with-the-same-24-plus-character-pairing-token
ALLOWED_ORIGIN=https://erp.yourmill.in
BRIDGE_PORT=17420

# Network thermal printer (preferred and platform-independent).
PRINTER_MODE=tcp
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100

# Alternative on Linux/macOS: PRINTER_MODE=cups and an allowlisted queue.
PRINTER_QUEUE=

# Optional TCP/serial-to-Ethernet weighing-scale endpoint. USB/RS-232 scales
# can instead use the ERP's direct Web Serial button in Chrome/Edge.
SCALE_TCP_HOST=
SCALE_TCP_PORT=4001
SCALE_TIMEOUT_MS=5000
